# ===============================================================
# FRONTEND PRINT COLLECT — printcollect.com.br
# ===============================================================
#
# ATENCAO: Geralmente voce NAO PRECISA editar este arquivo!
# - Se o painel estiver hospedado em printcollect.com.br (oficial),
#   o frontend detecta automaticamente a URL da API como
#   https://api.printcollect.com.br  sozinho.
#
# - Se voce rodar LOCALMENTE (localhost / rede local), tambem detecta
#   automaticamente como http://SEU-IP:8000
#
# - Preencha apenas se:
#    a) Voce estiver usando um dominio DIFERENTE de printcollect.com.br
#    b) Em previews do Vercel temporarios (xxxx.vercel.app)
# ===============================================================

# URL completa (inclua https:// e NAO termine com barra)
# Exemplos:
#   Producao: VITE_API_URL=https://api.printcollect.com.br
#   Dev local: VITE_API_URL=http://localhost:8000
VITE_API_URL=

# Apenas para PREVIEWS do Vercel temporarios (ex: xxxx.vercel.app)
# Se voce nao sabe o que e, DEIXE EM BRANCO.
VITE_API_URL_FALLBACK=
