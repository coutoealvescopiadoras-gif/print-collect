[Unit]
Description=Print Collect Agent — coleta de impressoras
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/print-collect
ExecStart=/opt/print-collect/.venv/bin/print-collect -c /opt/print-collect/config.yaml
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
