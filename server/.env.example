# Supabase PostgreSQL
# Substitua [YOUR-PASSWORD] pela senha do banco

# Transaction pooler (porta 6543) — use na API
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (porta 5432) — migrations / create_all
DIRECT_URL=postgresql://postgres.SEU_PROJECT_REF:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

SECRET_KEY=change-me-in-production
API_KEY=agent-dev-key
CORS_ORIGINS=http://localhost:5173
AUTO_CREATE_TABLES=false
