# =============================================================================
# VERCELIGNORE - NÃO INCLUIR ESTES ARQUIVOS/PASTAS NO PACOTE DE DEPLOY
# Reduz tamanho total do bundle de 235MB+ para <50MB (abaixo limite 225MB)
#
# REGRA MUITO IMPORTANTE: NÃO use /*.txt GENERICO - ele bloqueia
# requirements.txt e quebra o pip install no installCommand!
# =============================================================================

# PASTAS SOMENTE NA RAIZ - /agent/ tem .pydeps 300MB+, builds PyInstaller/Inno
/agent/
/dist/
/build/
/.pydeps/

# ARQUIVOS BUILD LOCAL NA RAIZ (NÃO use curingas genericos! Somente extensões específicas)
/*.spec
/*.bat
/*.ps1
/*.log
/*.lnk
/*.db
/*.sqlite
/*.sqlite3
/database/

# PYTHON CACHE / VENVS (qualquer nivel)
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.eggs/
.pytest_cache/
.coverage
htmlcov/
.venv/
.venv*/
venv/
env/
ENV/

# NODE_MODULES (qualquer nivel, só web/node_modules precisa no build)
node_modules/

# ARQUIVOS SEGREDOS / AMBIENTE
.env
.env.*
*.secret
