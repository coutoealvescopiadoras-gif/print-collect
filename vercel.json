{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd web && npm install && cd .. && pip install --break-system-packages -r requirements.txt",
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/docs", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/dashboard/:path*", "destination": "/index.html" },
    { "source": "/clientes", "destination": "/index.html" },
    { "source": "/clientes/:path*", "destination": "/index.html" },
    { "source": "/impressoras", "destination": "/index.html" },
    { "source": "/impressoras/:path*", "destination": "/index.html" },
    { "source": "/agentes", "destination": "/index.html" },
    { "source": "/agentes/:path*", "destination": "/index.html" },
    { "source": "/relatorios", "destination": "/index.html" },
    { "source": "/relatorios/:path*", "destination": "/index.html" },
    { "source": "/configuracoes", "destination": "/index.html" },
    { "source": "/configuracoes/:path*", "destination": "/index.html" },
    { "source": "/usuarios", "destination": "/index.html" },
    { "source": "/usuarios/:path*", "destination": "/index.html" },
    { "source": "/locais", "destination": "/index.html" },
    { "source": "/locais/:path*", "destination": "/index.html" },
    { "source": "/((?!assets/|.*\\..*|api/|health|docs|openapi\\.json).*)", "destination": "/index.html" }
  ]
}
